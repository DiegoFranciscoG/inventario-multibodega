# Copia este archivo a .env y completa los valores. .env NUNCA se sube a GitHub.
# Sin JWT_SECRET, DB_URL, DB_USER o DB_PASSWORD la aplicación no arranca (no hay valores por defecto para secretos).

# --- Base de datos (local: docker compose up -d db) ---
DB_URL=jdbc:postgresql://localhost:5432/inventario
DB_USER=inventario
DB_PASSWORD=

# --- Seguridad ---
# Secreto HS256 en Base64 de al menos 32 bytes. Genera uno con: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=PT30M
CORS_ALLOWED_ORIGINS=http://localhost:4200
LOGIN_ATTEMPTS_PER_MINUTE=10

# --- Primer administrador (opcional; contraseña de 12+ caracteres) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Datos de demostración ficticios (opcional) ---
APP_DEMO_ENABLED=false
DEMO_PASSWORD=

# --- Otros ---
PORT=8080
APP_SWAGGER_ENABLED=true
APP_TIME_ZONE=America/Guayaquil
APP_EXPIRING_DAYS=30
